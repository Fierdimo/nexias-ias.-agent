# URL del backend FastAPI.
# DISPOSITIVO FÍSICO: usa la IP LAN de tu Mac, NO localhost.
#   macOS: ipconfig getifaddr en0
# Ejemplo:
#   EXPO_PUBLIC_API_URL=http://192.168.1.50:8000
EXPO_PUBLIC_API_URL=http://localhost:8000

# --- Google Sign-In (para "Entrar con Google" + Picker) ---
# OAuth client tipo "Web" del mismo proyecto Google Cloud que el backend.
# Sirve para offlineAccess => serverAuthCode que el backend canjea.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# OAuth client tipo "iOS" (solo si vas a probar en iPhone).
# El iosUrlScheme también debe quedar en app.json (plugin google-signin).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

