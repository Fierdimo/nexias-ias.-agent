# --- App ---
ENVIRONMENT=local
# En producción usa orígenes concretos separados por coma
CORS_ORIGINS=*

# --- Supabase (DB + Auth) ---
# Vacío => el backend corre en MODO DEMO (usuario y datos ficticios)
# OJO: usa la BASE del proyecto, NO la "REST URL".
#   Correcto:   https://<ref>.supabase.co
#   Incorrecto: https://<ref>.supabase.co/rest/v1/
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# --- LLM ---
# llm_provider: mock | kimi | openai
LLM_PROVIDER=mock
LLM_API_KEY=
# Kimi/Moonshot internacional: https://api.moonshot.ai/v1
# Kimi/Moonshot China:        https://api.moonshot.cn/v1
LLM_BASE_URL=https://api.moonshot.ai/v1
LLM_MODEL=moonshot-v1-32k
LLM_MAX_TOKENS=1024

# --- Google Sheets (service account, FALLBACK) ---
# Vacío => usa dataset de muestra. Modelo recomendado: OAuth (abajo).
GOOGLE_CREDENTIALS_PATH=
GOOGLE_SHEET_ID=

# --- Google OAuth + Picker (recomendado: scope drive.file, sin CASA) ---
# OAuth client tipo "Web" (Google Cloud > Credenciales). Ver README §7.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_API_KEY=
GOOGLE_PROJECT_NUMBER=
# Clave para cifrar refresh tokens. Genera con:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TOKEN_ENC_KEY=

# --- Documentos ---
DOCUMENTS_DIR=../data/documents
